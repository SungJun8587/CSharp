<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Core.Redis</RootNamespace>
    <AssemblyName>Core.Redis</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS0419</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Util/Core.Util.csproj" />
    <ProjectReference Include="../Net/Core.Net.csproj" />
  </ItemGroup>

</Project>
