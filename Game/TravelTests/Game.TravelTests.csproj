<Project Sdk="Microsoft.NET.Sdk">

  <!-- 존 이동 상태 유지 통합 테스트: 실제 소켓으로 Gateway + 존 서버 2개 + 클라이언트를 한 프로세스에 띄운다. 실행: dotnet run (프로젝트 폴더에서), 변환기 없이 빌드하려면 속성 SkipXlsxConverterBuild=true 를 준다 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Game.TravelTests</RootNamespace>
    <AssemblyName>Game.TravelTests</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GameCommon/Generated/Game.Generated.csproj" />
    <ProjectReference Include="../GameCommon/ZoneCommon/Game.ZoneCommon.csproj" />
    <ProjectReference Include="../GameCommon/ZoneCore/Game.ZoneCore.csproj" />
    <ProjectReference Include="../ZoneServer/Game.ZoneServer.csproj" />
    <ProjectReference Include="../GatewayServer/Game.GatewayServer.csproj" />
    <ProjectReference Include="../Persistence/Game.Persistence.csproj" />
    <ProjectReference Include="../../Library/Core/Net/Core.Net.csproj" />
    <ProjectReference Include="../../Library/Core/Util/Core.Util.csproj" />
  </ItemGroup>

</Project>
